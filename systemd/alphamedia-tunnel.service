[Unit]
Description=AlphaMedia Cloudflare named tunnel (api.alphamedia.bond)
After=network-online.target alphamedia-api.service cloudflared-edge-fwd.service
Wants=network-online.target
Requires=alphamedia-api.service

[Service]
Type=simple
User=root
Environment=TUNNEL_TRANSPORT_PROTOCOL=http2
ExecStart=/bin/bash -c 'exec /usr/local/bin/cloudflared tunnel --no-autoupdate --config /home/hatch/workspace/tgbot/systemd/cloudflared-alphamedia.yml run --token "$(cat /home/hatch/.cloudflared-alphamedia-token)"'
Restart=always
RestartSec=10
StandardOutput=append:/var/log/alphamedia-tunnel.log
StandardError=append:/var/log/alphamedia-tunnel.log

[Install]
WantedBy=multi-user.target
