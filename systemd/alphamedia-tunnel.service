[Unit]
Description=AlphaMedia public tunnel (cloudflared quick tunnel)
After=network-online.target alphamedia-api.service alphamedia-cf-api-fwd.service
Wants=network-online.target alphamedia-api.service
Requires=alphamedia-cf-api-fwd.service

[Service]
Type=simple
User=root
EnvironmentFile=/home/hatch/.config/alphamedia-api/env
Environment=TUNNEL_TRANSPORT_PROTOCOL=http2
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8000
Restart=always
RestartSec=10
StandardOutput=append:/var/log/alphamedia-tunnel.log
StandardError=append:/var/log/alphamedia-tunnel.log

[Install]
WantedBy=multi-user.target
